# vault service
VAULT_ADDR=http://0.0.0.0:8200
VAULT_API_ADDR=http://0.0.0.0:8200
VAULT_ADDRESS=http://0.0.0.0:8200
RELEASE_VERSION=v2.1.0
# identity service
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_BASE_URL=http://vault:8200/v1
VAULT_ROOT_PATH=http://vault:8200/v1/kv
VAULT_TIMEOUT=5000
VAULT_PROXY=false
SIGNING_ALGORITHM=Ed25519Signature2020
JWKS_URI=
ENABLE_AUTH=false
WEB_DID_BASE_URL=

# schema service
IDENTITY_BASE_URL=http://identity:3332
JWKS_URI=
ENABLE_AUTH=false

# credential service
IDENTITY_BASE_URL=http://identity:3332
SCHEMA_BASE_URL=http://schema:3333
CREDENTIAL_SERVICE_BASE_URL=http://credential:3000
JWKS_URI=
ENABLE_AUTH=false
QR_TYPE=W3C_VC

# db service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# oid4vc service (optional; enable with `docker compose --profile oid4vc up -d`)
# PUBLIC_URL must be a host a wallet/phone can resolve — it feeds the QR
# deep link and the proof-of-possession `aud` claim, so localhost only works
# for same-machine testing.
OID4VC_PUBLIC_URL=http://localhost:3400
OID4VC_INTERNAL_URL=http://oid4vc-service:3400
# No redis service in this stack, so the session store stays in-memory.
OID4VC_SESSION_STORE=memory
OID4VC_REDIS_URL=redis://redis:6379
OID4VC_ISSUER_DID=
OID4VP_ENABLED=true
OID4VC_DRAFT13_COMPAT=false
OID4VP_SIGN_REQUEST=false
# Set true for walt.id wallet interop.
OID4VP_LEGACY_CLIENT_ID_SCHEME=false
OID4VC_VERIFIER_DID=
AUTH_ISSUER=
